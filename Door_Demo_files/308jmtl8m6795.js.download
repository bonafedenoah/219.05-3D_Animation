  /*
   * The height the chat trusts is --lw-frame-height, and it is unset almost always: every rule below
   * then falls back to 100dvh, the frame's own height. A host that grows our frame without settling
   * gets it set instead, to the height from before that growth began, so the chat keeps its shape
   * while the frame stretches past it. See FRAME_HEIGHT_FREEZE_SCRIPT in utils/documentBootstrap.ts.
   */
  position: relative;

  width: 100vw;
  height: var(--lw-frame-height, 100dvh);

  max-width: 100vw;
  max-height: var(--lw-frame-height, 100dvh);

  border-radius: 16px;
  overflow: hidden;
  outline: none;

  /*
   * While the height is pinned it is shorter than the frame actually offers, so the shell scrolls
   * rather than clips: content that reflows taller than the pin — a learner's text-spacing
   * overrides, most plainly — stays reachable, and reflow fires no resize event for the pin to
   * release on. Unpinned, the shell clips as before, its own regions doing the scrolling.
   */
  html[data-frame-height-pinned] & {
    overflow-y: auto;
  }

  &:focus-visible {
    outline: 2px solid var(--lw-focus-ring-color);
    outline-offset: 2px;
  }

  ${({$fullscreen:e})=>e&&t9.css`
      max-height: var(--lw-frame-height, 100dvh);
      width: calc(100vw - 32px);
      height: calc(var(--lw-frame-height, 100dvh) - 32px);
      margin: 16px auto;

      ${nN(t9.css`
        width: 100vw;
        height: var(--lw-frame-height, 100dvh);
        margin: 0;
      `)}
    `}

  ${({$fullscreen:e,$inputFocused:t})=>{let n;return e&&t&&t9.css`
      @media (hover: none) {
        ${nN(t9.css`
          height: calc(var(--lw-frame-height, 100dvh) - 400px);
        `)}

        ${n=t9.css`
          height: calc(var(--lw-frame-height, 100dvh) - 270px);
        `,t9.css`
    @media ${"(max-width: 767px)"} {
      ${n}
    }
  `}
      }
    `}}

  ${({$showFull:e})=>!e&&t9.css`
      ${nN(t9.css`
        border-radius: 0;
      `)}
    `}
